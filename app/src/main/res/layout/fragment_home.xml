<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dimens_16">

        <!-- 音乐继续播放卡片 -->
        <include
            android:visibility="gone"
            android:id="@+id/include_audio_card"
            layout="@layout/include_home_audio_card" />

        <!-- 视频继续播放卡片 -->
        <include
            android:visibility="gone"
            android:id="@+id/include_video_card"
            layout="@layout/include_home_video_card" />

        <!-- 2. 快捷功能按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/dimens_16"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_audio"
                android:layout_width="@dimen/dimens_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scan_audio"
                style="@style/Widget.Material3.Button"
                android:layout_marginEnd="@dimen/dimens_4" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="@dimen/dimens_0"
                android:id="@+id/scan_video"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scan_video"
                style="@style/Widget.Material3.Button"
                android:layout_marginStart="@dimen/dimens_4" />
        </LinearLayout>


        <!-- 3. 媒体库统计 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimens_16"
            style="@style/Widget.Material3.CardView.Filled"
            app:cardCornerRadius="@dimen/dimens_12"
            app:cardElevation="@dimen/dimens_0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dimens_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/library_statistics"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/dimens_12" />

                <!-- 音乐统计 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/dimens_8">

                    <TextView
                        android:layout_width="@dimen/dimens_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="音乐"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="128 首"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 视频统计 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/dimens_8">

                    <TextView
                        android:layout_width="@dimen/dimens_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="视频"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 个"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 空间占用 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dimens_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/occupied_space"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8.4 GB"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. 最近播放 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recent_play"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/dimens_8" />
        <ink.x2.mymedia.widget.CustomTabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_media_linear" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>