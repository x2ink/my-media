<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    tools:context=".feature.scan.ScanActivity">

    <!-- AppBarLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/scan_title"
            app:navigationIcon="@android:drawable/ic_menu_revert" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <!-- Circular Scan Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scan"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:text="@string/scan_action"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="70dp"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp" />

            <!-- Scan Results Header -->
            <TextView
                android:id="@+id/tv_results_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_results"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_results"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:visibility="gone" />

            <!-- RecyclerView for Scan Results -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_scan_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_media_linear" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>