<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    tools:context=".feature.scan.ScanActivity">

    <!-- AppBarLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Area for Scan Actions and Results -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_0"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dimens_16"
            android:gravity="center_horizontal">

            <!-- Circular Scan Button -->
            <!-- 圆形扫描按钮容器 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_scan"
                android:layout_width="@dimen/dimens_140"
                android:layout_height="@dimen/dimens_140"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dimens_32"
                android:layout_marginBottom="@dimen/dimens_32"
                android:translationY="@dimen/dimens_64"
                app:cardCornerRadius="@dimen/dimens_70"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardElevation="@dimen/dimens_0"
                app:strokeWidth="@dimen/dimens_0"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/dimens_16">

                    <ImageView
                        android:id="@+id/iv_scan_icon"
                        android:layout_width="@dimen/dimens_48"
                        android:layout_height="@dimen/dimens_48"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorOnPrimary" />

                    <!-- 扫描文字 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimens_8"
                        android:text="@string/scan_action"
                        android:textColor="?attr/colorOnPrimary"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scan Results Header -->
            <TextView
                android:alpha="0"
                android:id="@+id/tv_results_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_results"
                android:layout_marginBottom="@dimen/dimens_16"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <!-- Empty State -->
            <TextView
                tools:visibility="visible"
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_results"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"
                android:layout_marginTop="@dimen/dimens_24"
                android:visibility="gone" />

            <!-- RecyclerView for Scan Results -->
            <androidx.recyclerview.widget.RecyclerView
                android:alpha="0"
                android:id="@+id/rv_scan_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_media_linear" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Control Bar for Bulk Operations -->
    <com.google.android.material.card.MaterialCardView
        android:alpha="0"
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.CardView.Elevated"
        app:cardCornerRadius="@dimen/dimens_0"
        app:cardElevation="@dimen/dimens_8"
        android:backgroundTint="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dimens_20"
            android:paddingEnd="@dimen/dimens_20"
            android:paddingTop="@dimen/dimens_12"
            android:paddingBottom="@dimen/dimens_12">

            <!-- Select All Checkbox -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_select_all"
                android:checked="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全选"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <View
                android:layout_width="@dimen/dimens_0"
                android:layout_height="@dimen/dimens_1"
                android:layout_weight="1" />

            <!-- Import Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="导入"
                style="@style/Widget.Material3.Button.TonalButton"
                app:icon="@drawable/ic_import"
                app:iconGravity="textStart"
                android:paddingStart="@dimen/dimens_20"
                android:paddingEnd="@dimen/dimens_20" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>