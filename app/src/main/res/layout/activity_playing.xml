<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- AppBar/Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="@dimen/dimens_0"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="正在播放"
            app:titleCentered="true">

            <!-- Actions button: More Options -->
            <ImageView
                android:id="@+id/btn_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_more"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/dimens_16"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="更多" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Album Art Cover -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_album_art"
        android:layout_width="@dimen/dimens_280"
        android:layout_height="@dimen/dimens_280"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music"
        android:background="?attr/colorSurfaceVariant"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toTopOf="@id/ll_info"
        android:layout_marginTop="@dimen/dimens_24"
        android:layout_marginBottom="@dimen/dimens_24" />

    <!-- Info: Title & Artist -->
    <LinearLayout
        android:id="@+id/ll_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/dimens_32"
        android:paddingEnd="@dimen/dimens_32"
        app:layout_constraintTop_toBottomOf="@id/iv_album_art"
        app:layout_constraintBottom_toTopOf="@id/ll_progress"
        android:layout_marginBottom="@dimen/dimens_24">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="歌曲名称"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="歌手名称"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="@dimen/dimens_8"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Progress: SeekBar & Durations -->
    <LinearLayout
        android:id="@+id/ll_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dimens_8"
        android:paddingEnd="@dimen/dimens_8"
        app:layout_constraintTop_toBottomOf="@id/ll_info"
        app:layout_constraintBottom_toTopOf="@id/ll_controls"
        android:layout_marginBottom="@dimen/dimens_24">

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="0"
            android:progress="0"
            android:paddingStart="@dimen/dimens_16"
            android:paddingEnd="@dimen/dimens_16"
            app:splitTrack="false" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_8"
            android:paddingStart="@dimen/dimens_16"
            android:paddingEnd="@dimen/dimens_16">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_alignParentStart="true" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Controls: Prev, Play/Pause, Next -->
    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="@dimen/dimens_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_progress">

        <!-- Previous Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prev"
            android:layout_width="@dimen/dimens_56"
            android:layout_height="@dimen/dimens_56"
            style="@style/Widget.Material3.Button.IconButton"
            app:icon="@drawable/ic_skip_previous"
            app:iconSize="@dimen/dimens_28"
            app:iconTint="?attr/colorOnSurface"
            android:layout_marginEnd="@dimen/dimens_24" />

        <!-- Play/Pause Floating/Circular Filled Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_play"
            android:layout_width="@dimen/dimens_80"
            android:layout_height="@dimen/dimens_80"
            style="@style/Widget.Material3.Button"
            app:cornerRadius="@dimen/dimens_40"
            android:backgroundTint="?attr/colorPrimary"
            app:iconSize="@dimen/dimens_36"
            app:iconTint="?attr/colorOnPrimary"
            app:iconPadding="@dimen/dimens_0"
            android:insetTop="@dimen/dimens_0"
            android:insetBottom="@dimen/dimens_0" />

        <!-- Next Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="@dimen/dimens_56"
            android:layout_height="@dimen/dimens_56"
            style="@style/Widget.Material3.Button.IconButton"
            app:icon="@drawable/ic_skip_next"
            app:iconSize="@dimen/dimens_28"
            app:iconTint="?attr/colorOnSurface"
            android:layout_marginStart="@dimen/dimens_24" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>